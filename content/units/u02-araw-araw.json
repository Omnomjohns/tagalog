 "patterns": [
  {
   "id": "u02-g01",
   "unitId": "u02",
   "name": "Actor focus: -um- and mag-",
   "explanationEn": "In actor focus the doer is the ang-phrase (or ako/ka/siya). Each root takes either -um- or mag-; this has to be learned with the verb.",
   "formula": "-um- verbs · mag- verbs",
   "examples": [
    {
     "tl": "Kumain ako.",
     "en": "I ate."
    },
    {
     "tl": "Nagluto ako.",
     "en": "I cooked."
    }
   ],
   "skills": [
    "focus_actor"
   ]
  },
  {
   "id": "u02-g02",
   "unitId": "u02",
   "name": "Three aspects of -um- verbs",
   "explanationEn": "Completed: -um- in the root. Incompleted: -um- plus the first syllable repeated. Contemplated: only the first syllable repeated, no -um-.",
   "formula": "kumain · kumakain · kakain",
   "examples": [
    {
     "tl": "Kumain ako kanina.",
     "en": "I ate earlier."
    },
    {
     "tl": "Kumakain ako ngayon.",
     "en": "I am eating now."
    },
    {
     "tl": "Kakain ako mamaya.",
     "en": "I will eat later."
    }
   ],
   "skills": [
    "aspect",
    "focus_actor"
   ]
  },
  {
   "id": "u02-g03",
   "unitId": "u02",
   "name": "Three aspects of mag- verbs",
   "explanationEn": "Completed: nag-. Incompleted: nag- plus the first syllable repeated. Contemplated: mag- plus the first syllable repeated.",
   "formula": "nagluto · nagluluto · magluluto",
   "examples": [
    {
     "tl": "Nag-aral ako kagabi.",
     "en": "I studied last night."
    },
    {
     "tl": "Nag-aaral ako.",
     "en": "I am studying."
    },
    {
     "tl": "Mag-aaral ako bukas.",
     "en": "I will study tomorrow."
    }
   ],
   "skills": [
    "aspect",
    "focus_actor"
   ]
  },
  {
   "id": "u02-g04",
   "unitId": "u02",
   "name": "Enclitics after the first word",
   "explanationEn": "Short particles and pronouns cluster right after the first word of the clause. When a time word or hindi comes first, they follow it instead of the verb.",
   "formula": "FIRST WORD + ka/ko/mo + na/pa + rin/lang/po/ba + other pronouns",
   "examples": [
    {
     "tl": "Kumain ka na ba?",
     "en": "Have you eaten already?"
    },
    {
     "tl": "Hindi pa ako kumakain.",
     "en": "I haven't eaten yet."
    },
    {
     "tl": "Palagi akong umiinom ng kape.",
     "en": "I always drink coffee."
    }
   ],
   "skills": [
    "enclitics",
    "word_order"
   ]
  }
 ],
